# What the login user may run as root, and nothing else. computer/install.sh installs this file as
# /etc/sudoers.d/teletraan-control after checking it with visudo, and puts the login user in place of ACCOUNT.
# The helper of the control page, the scheduled reboot, the watchdog and the nightly job run these by the first
# path of each. Every line names one command with all of its arguments, so sudo allows that command and no other:
# there is no wildcard, and a different unit or an extra argument does not match. Add a command by adding a line,
# and add it to the list in tests/sudoers.test.mjs too.
# On Debian /bin is a link to /usr/bin and /sbin to /usr/sbin, and reboot is a link to systemctl, so the other
# spellings of the reboot are listed in case sudo compares the path as typed.
Cmnd_Alias TELETRAAN_SCREEN = \
  /usr/bin/systemctl restart teletraan-kiosk.service, \
  /usr/bin/systemctl start teletraan-mirror.service

Cmnd_Alias TELETRAAN_TIMERS = \
  /usr/bin/systemctl restart teletraan-calendars.timer, \
  /usr/bin/systemctl restart teletraan-monday.timer, \
  /usr/bin/systemctl restart teletraan-slides.timer, \
  /usr/bin/systemctl restart teletraan-watchdog.timer, \
  /usr/bin/systemctl restart teletraan-nightly.timer, \
  /usr/bin/systemctl restart teletraan-reboot.timer

Cmnd_Alias TELETRAAN_SYNCS = \
  /usr/bin/systemctl start teletraan-calendars.service, \
  /usr/bin/systemctl start teletraan-monday.service, \
  /usr/bin/systemctl start teletraan-frc.service, \
  /usr/bin/systemctl start teletraan-news.service, \
  /usr/bin/systemctl start teletraan-photos-drive.service, \
  /usr/bin/systemctl start teletraan-match13.service

Cmnd_Alias TELETRAAN_WEB = \
  /usr/bin/docker restart teletraan-web

Cmnd_Alias TELETRAAN_REBOOT = \
  /usr/bin/systemctl reboot, \
  /bin/systemctl reboot, \
  /usr/sbin/reboot, \
  /sbin/reboot

ACCOUNT ALL=(root) NOPASSWD: TELETRAAN_SCREEN, TELETRAAN_TIMERS, TELETRAAN_SYNCS, TELETRAAN_WEB, TELETRAAN_REBOOT

# The git hook runs the install as root through this wrapper, which checks its two arguments itself (computer/git/install-tree-as-root.sh).
# With no argument list in the rule, sudo allows any arguments, so the wrapper is the check. Only this path may run.
ACCOUNT ALL=(root) NOPASSWD: /usr/local/sbin/teletraan-install-tree
