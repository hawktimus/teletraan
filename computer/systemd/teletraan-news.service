[Unit]
Description=Read the FIRST news headlines for Teletraan I
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ACCOUNT is replaced by install-news.sh with the account that owns the
# repository, so this file does not depend on what the Teletraan computer's user is called.
User=ACCOUNT
ExecStart=/opt/teletraan/computer/scripts/news-sync.sh
# Tells Studio when the headlines were read and how many there are. The leading minus means a
# failure here is ignored: the status must never mark a read as failed.
ExecStartPost=-/opt/teletraan/computer/scripts/status-write.sh news
# Each request gives up after 30 seconds. This is for the whole run.
TimeoutStartSec=5min
