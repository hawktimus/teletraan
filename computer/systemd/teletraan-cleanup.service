[Unit]
Description=Delete the items in Studio that expired a while ago, when Dashboard Settings says so
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ACCOUNT is replaced by install-cleanup.sh with the account that owns the
# repository, so this file does not depend on what the Teletraan computer's user is called.
User=ACCOUNT
# This job reads the network and writes its own files. It never needs more rights than it starts with.
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The script deletes only while Clean up expired items is on and its Mode is Delete. It tells Studio the result itself
# (status-write.sh cleanup).
ExecStart=/opt/teletraan/computer/scripts/expired-cleanup.sh
# Each request gives up after 60 seconds. This is for the whole run.
TimeoutStartSec=15min
