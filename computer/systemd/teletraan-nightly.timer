[Unit]
Description=Restart the Teletraan I screen at 04:00 and reboot the Teletraan computer at 04:10 on Sundays

[Timer]
# The time zone of the Teletraan computer, which is the kiosk time. Not Persistent: a run
# that was missed because the Teletraan computer was off must not restart the screen later in the day.
OnCalendar=*-*-* 04:00:00
OnCalendar=Sun *-*-* 04:10:00
Persistent=false

[Install]
WantedBy=timers.target
