[Unit]
Description=Back up the Teletraan I Sanity dataset
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ACCOUNT is replaced by install-backup.sh with the account that owns the
# repository, so this file does not depend on what the Teletraan computer's user is called.
User=ACCOUNT
# This job reads the network and writes its own files. It never needs more rights than it starts with.
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The script tells Studio the time (status-write.sh backup) only after an export that worked.
ExecStart=/opt/teletraan/computer/scripts/backup-dataset.sh
# The export downloads every photo too
TimeoutStartSec=1h
