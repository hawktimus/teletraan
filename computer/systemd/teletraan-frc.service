[Unit]
Description=Read the FRC competition data for Teletraan I
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ACCOUNT is replaced by install-frc.sh with the account that owns the
# repository, so this file does not depend on what the Teletraan computer's user is called.
User=ACCOUNT
# This job reads the network and writes its own files. It never needs more rights than it starts with.
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The script decides whether it is time. It tells Studio when it finished
# (status-write.sh frc) only after a run that worked, so there is no
# ExecStartPost here.
ExecStart=/opt/teletraan/computer/scripts/frc-sync.sh
# Each request gives up after 30 seconds and a run makes at most 60. This is for
# the whole run.
TimeoutStartSec=15min
