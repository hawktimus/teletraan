[Unit]
Description=Read the content and the weather for the Teletraan I dashboard and keep the last good copy
After=network.target

[Service]
# ACCOUNT is replaced by install-sync.sh and install.sh with the account that owns the repository. The data folder is the
# one in TELETRAAN_DATA of local.env, which install-sync.sh writes on the Environment line when it is not the usual one. The
# service writes only that folder and the log folder /var/log/teletraan. It reads one key from local.env by name, SANITY_READ_TOKEN
# (or SANITY_WRITE_TOKEN when that is not set), and only when the dataset has been made private.
User=ACCOUNT
Environment=TELETRAAN_DATA=/var/lib/teletraan/data
UMask=0022
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The calendars and Monday are read on their own timers, every 15 and every 30 minutes. After a boot that means their
# stamps can be half an hour old before anything reads them again, and the dots on the wall sit amber in the meantime
# while nothing is in fact wrong. These two run once, first, so the stamps are fresh within a minute of a boot. Each is
# allowed to fail: the service must start even when the network is not up yet.
ExecStartPre=-/opt/teletraan/computer/scripts/fetch-calendars.sh
ExecStartPre=-/opt/teletraan/computer/scripts/monday-sync.sh
ExecStart=/usr/bin/env node /opt/teletraan/computer/scripts/sync-service.mjs
# A service that stops is started again after 5 seconds, whatever the reason
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
