[Unit]
Description=Watch the Google Drive folder of presentations for Teletraan I
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# ACCOUNT is replaced by install-decks.sh with the account that owns the
# repository, so this file does not depend on what the Teletraan computer's user is called.
User=ACCOUNT
# This job reads the network and writes its own files. It never needs more rights than it starts with.
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# Looks at the folder every 20 seconds and makes the pictures of each new or changed deck
ExecStart=/opt/teletraan/computer/scripts/decks-sync.sh --watch
# A watcher that stops is started again, with a pause so a fault that repeats does not spin
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
