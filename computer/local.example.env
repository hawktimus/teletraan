# Copy this file to local.env and fill it in. The real file is local.env: it
# is never committed and only the Teletraan computer's account may read it (chmod 600).
#
# One NAME=value per line. Put each value in single quotes and do not put a
# comment on the same line as a value.

# The folder on the Teletraan computer where downloaded calendars, slides and version.txt
# are kept. It must exist before the container starts, and the account that
# runs the timers must be allowed to write to it.
TELETRAAN_DATA='/var/lib/teletraan/data'

# The dashboard is reachable at http://localhost:<port>/dashboard/ on the Teletraan computer only
TELETRAAN_PORT='8080'

# One line per BAND calendar: CALENDAR_<ID>_URL. Use capital letters, digits
# and underscores in the ID. The calendar is saved as <id in lowercase>.ics,
# so CALENDAR_TEAM_URL becomes team.ics. The dashboard only shows a calendar
# that has a row in Dashboard Settings, Calendars, whose code is that same
# lowercase id. Use the https:// or webcal:// address. A value that still
# starts with [ is skipped.
CALENDAR_TEAM_URL='[paste the iCal address of the team calendar here]'

# A token that lets the Teletraan computer write what it did into Sanity, which Dashboard
# Settings shows in the status block. Create it at sanity.io/manage, in the
# project, under API, Tokens, with Editor access. The Teletraan computer works without it, and
# Studio then shows No status yet. A value that still starts with [ is skipped.
SANITY_WRITE_TOKEN='[paste the Sanity write token here]'

# A read key for the FRC feed (docs/frc-feed.md). Make one on the account page at
# thebluealliance.com/account, under Read API Keys. It goes in this file and
# nowhere else. A value that still starts with [ is skipped.
TBA_AUTH_KEY='[paste the read key here]'

# A Google API key for the Drive photo folder (docs/photos-drive.md). Make it in the Google Cloud
# console, restrict it to the Google Drive API, and share the folder with Anyone with the link as
# Viewer. It goes in this file and nowhere else. The Teletraan computer works without it: the Photo
# panel then shows only the photos uploaded in Studio. A value that still starts with [ is skipped.
# GOOGLE_API_KEY='[paste the Google key here]'

# A personal API token for the Monday boards (docs/monday.md). In Monday, open your
# avatar, then Developers, then My access tokens, and copy the token. It goes in
# this file and nowhere else. Use the token of an account that can see only the
# team's boards, because the names of the boards it sees are written to Sanity,
# which anyone can read. A value that still starts with [ is skipped.
MONDAY_API_TOKEN='[paste the Monday token here]'

# The control page at http://teletraan.local:3229/control/ (docs/control-page.md) takes the PINs 3229 and 3426
# and needs nothing set here. To make it take one other PIN instead (4 to 12 digits), remove the # on the next
# line and put the PIN in it, by hand over SSH. The Mac tool and the Keys tab do not touch this line.
# CONTROL_PIN='[the one PIN]'

# A token with the Deploy Studio permission, only for npm run deploy to the hosted copy
# (teletraan.sanity.studio). The Teletraan computer does not need it. It goes in this file and nowhere else.
# SANITY_AUTH_TOKEN='[paste the deploy token here]'
