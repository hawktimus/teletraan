.DS_Store
node_modules/
__pycache__/
*.pyc

# the local settings file holds secrets, so every name it could be saved under is ignored
local.env*
*.env
.env
.env.*
*.save
*~
*.bak
.*.swp
!local.example.env
!*.example.env

# the build stamp the Mac tool leaves on the Mini (mini/scripts/status-write.sh version)
mini/build.txt

# the build the page asks its files for, written by kiosk.sh and the Mac tool (dashboard/build.example.js)
dashboard/build.js

dashboard/data/live/*
!dashboard/data/live/.gitkeep

# a CSV made by studio/scripts/import-csv.mjs, ready for sanity dataset import
studio/import.ndjson

# the dashboard copied into the Studio for the panel preview (studio/scripts/copy-dashboard.mjs)
studio/static/dashboard/

# the pictures made by tools/screenshots.mjs
_outputs/
