#!/bin/bash
# Updates the Teletraan computer from this Mac, and keeps its keys and its calendar links.
# Run it by double-clicking "Teletraan Tool.command" in Finder, or in a terminal:
#
#   tools/teletraan/teletraan-tool                 the menu
#   tools/teletraan/teletraan-tool update          copy the files, then restart the screen
#   tools/teletraan/teletraan-tool status          show what the Teletraan computer last did
#   tools/teletraan/teletraan-tool restart         restart the screen
#
# A word after the name does what the same choice in the menu does, with no menu,
# and the exit code is not zero when a step fails, so tools/mac/ship.sh can rely on
# it. --yes skips the "Go ahead?" question of update, and --computer NAME picks a saved
# computer other than the one in use. docs/updating-the-computer.md explains each choice.
#
# The keys and the calendar links are secrets. They live in ~/.teletraan/secrets.env
# on this Mac and in computer/local.env on the Teletraan computer, and nowhere else. This script
# never prints one: it shows the first 4 characters and dots, and it sends the
# values with scp, so no command line carries one.
#
# This runs on the bash that comes with macOS, which is version 3.2. That is why
# it has no associative arrays and no case conversion in the shell itself.

set -u

# The Teletraan computer's repository folder and the name of the screen's service. These are
# not secrets; change them here if the Teletraan computer changes.
COMPUTER_REPO=${COMPUTER_REPO:-/opt/teletraan}
COMPUTER_KIOSK=${COMPUTER_KIOSK:-teletraan-kiosk.service}
# The folder in the login user's home on the Teletraan computer where the files are put before the installer runs
COMPUTER_STAGING=${COMPUTER_STAGING:-teletraan-staging}

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd "$here/../.." && pwd)

state_dir=$HOME/.teletraan
config_file=$state_dir/config
secrets_file=$state_dir/secrets.env

# What a key, a link, an address and a name may look like. The keys use the rule
# the scripts on the Teletraan computer use. A link is checked for the characters a calendar
# address has, because it is written between quotes in two other files.
key_pattern='^[A-Za-z0-9_.-]+$'
link_pattern='^[A-Za-z0-9._~:/?#@!&()*+,;=%-]+$'
address_pattern='^[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._-]*$'
name_pattern='^[a-z0-9][a-z0-9_-]{0,19}$'
folder_pattern='^/[A-Za-z0-9/._-]+$'

# The computers this Mac knows, and the one in use
computer_names=()
computer_addresses=()
computer_count=0
current_name=''
computer_name=''
address=''

# The keys and calendars saved on this Mac. A key is 0 when it is not set, 1 when
# it has a value and 2 when it was cleared and the Teletraan computer has not been told yet. A
# calendar with an empty value was removed and the Teletraan computer has not been told yet.
key_names=(SANITY_WRITE_TOKEN MONDAY_API_TOKEN TBA_AUTH_KEY CONTROL_PIN)
key_labels=('Sanity write token' 'Monday token' 'The Blue Alliance key' 'Control page PIN')
key_uses=('lets the Teletraan computer write its status and the Monday tasks into Sanity' 'lets the computer read the Monday boards' 'lets the computer read the competition data' 'lets coaches sign in to the control page, 6 to 12 digits')
key_values=('' '' '' '')
key_states=(0 0 0 0)
# The form of choice 2 asks for the first three. The PIN of the control page has choice 8.
form_key_count=3
cal_names=()
cal_values=()
cal_count=0

# Filled by check_key, check_link and prompt
clean_value=''
clean_reason=''
answer=''

# The functions are in the files beside this one
for part in ui secrets config deploy keys; do
  source "$here/teletraan-tool-$part.sh"
done

# Set when a command word is given instead of the menu. The steps are the same.
# What differs: a question that nobody answers counts as no, and a step that did
# not happen is a failure, because a script is waiting for the exit code.
command_mode=no
assume_yes=no
declined_status=0

# Puts one NAME=value line into the lists. A value that is empty, a placeholder
# or not usable is left out, and its name is added to $skipped.
skipped=''

# Where a changed value is noted for the list before saving
change_notes=()
change_count=0

# The calendars that have a link, numbered. visible[n] is their place in the list.
visible=()
visible_count=0

show_menu() {
  say ""
  say "Teletraan Tool"
  say ""
  say "Teletraan computer in use: $computer_name ($address)"
  say ""
  say "  1  Install the files on this Mac as the next release on the Teletraan computer, then restart the screen"
  say "  2  Keys and calendars"
  say "  3  Copy the Teletraan computer's keys and calendars to this Mac"
  say "  4  Install the services on the Teletraan computer"
  say "  5  Status of the Teletraan computer"
  say "  6  Restart the screen"
  say "  7  Choose another computer, or add one"
  say "  8  Set the PIN of the control page"
  say "  q  Quit"
  say ""
}

usage() {
  say "Usage: teletraan-tool [--computer NAME] [--yes] [update | status | restart]"
  say ""
  say "  (no word)  show the menu"
  say "  update     copy the files to the Teletraan computer and install them as the next release (the first time it also sets up the control page)"
  say "  status     show what the Teletraan computer last did"
  say "  restart    restart the screen"
  say "  --yes      with update, do not ask Go ahead?"
  say "  --computer     use the saved computer with this name instead of the one in use"
}

# A wrong word is not repeated back, in case it was a key or an address typed by mistake
bad_arguments() {
  problem "$1"
  usage >&2
  exit 2
}

saved_names() {
  local i=0 list=''
  while [ "$i" -lt "$computer_count" ]; do
    if [ -n "$list" ]; then list="$list, "; fi
    list="$list${computer_names[$i]}"
    i=$((i + 1))
  done
  printf '%s' "$list"
}

main() {
  local command command_word='' wanted_computer='' wanted i=0 found=no
  while [ "$#" -gt 0 ]; do
    case $1 in
      update|status|restart)
        if [ -n "$command_word" ]; then bad_arguments "give one word, not two."; fi
        command_word=$1
        ;;
      --yes|-y) assume_yes=yes ;;
      --computer)
        if [ "$#" -lt 2 ]; then bad_arguments "--computer needs the name of a saved computer."; fi
        wanted_computer=$2
        shift
        ;;
      --computer=*) wanted_computer=${1#--computer=} ;;
      -h|--help|help) usage; exit 0 ;;
      *) bad_arguments "that is not a word this tool knows." ;;
    esac
    shift
  done
  if [ "$assume_yes" = yes ] && [ -z "$command_word" ]; then
    bad_arguments "--yes goes with update, status or restart."
  fi

  for command in ssh scp rsync; do
    if ! command -v "$command" > /dev/null 2>&1; then
      problem "$command is not installed on this Mac. It comes with macOS, so something is wrong with this Mac."
      exit 1
    fi
  done
  if ! printf '%s' "$COMPUTER_REPO" | grep -Eq "$folder_pattern"; then
    problem "COMPUTER_REPO must be a plain folder path such as /opt/teletraan."
    exit 1
  fi
  if ! printf '%s' "$COMPUTER_STAGING" | grep -Eq '^[A-Za-z0-9][A-Za-z0-9._-]*$'; then
    problem "COMPUTER_STAGING must be a plain folder name such as teletraan-staging."
    exit 1
  fi
  if ! printf '%s' "$COMPUTER_KIOSK" | grep -Eq "$key_pattern"; then
    problem "COMPUTER_KIOSK must be the name of a service such as teletraan-kiosk.service."
    exit 1
  fi

  # Ctrl+C while a hidden value is being typed must not leave the terminal silent
  trap 'stty echo 2> /dev/null; session_close' EXIT
  session_open

  mkdir -p "$state_dir" && chmod 700 "$state_dir" || { problem "could not make $state_dir."; exit 1; }
  load_config
  if [ -n "$command_word" ]; then
    command_mode=yes
    declined_status=1
  fi
  if [ "$computer_count" = 0 ]; then
    if [ "$command_mode" = yes ]; then
      problem "no computer is saved on this Mac yet. Run tools/teletraan/teletraan-tool with no word after it, once, and give it the Teletraan computer's address."
      exit 1
    fi
    first_run || exit 1
  fi

  wanted=${wanted_computer:-$current_name}
  use_computer 0
  while [ "$i" -lt "$computer_count" ]; do
    if [ "${computer_names[$i]}" = "$wanted" ]; then
      use_computer "$i"
      found=yes
    fi
    i=$((i + 1))
  done
  if [ -n "$wanted_computer" ] && [ "$found" = no ]; then
    problem "no saved computer has that name. The saved names are: $(saved_names)."
    exit 1
  fi

  case $command_word in
    update) update_computer; exit $? ;;
    status) computer_status; exit $? ;;
    restart) restart_screen; exit $? ;;
  esac

  while true; do
    show_menu
    prompt "Choose: "
    case $answer in
      1) update_computer ;;
      2) keys_and_calendars ;;
      3) pull_from_computer ;;
      4) install_services ;;
      5) computer_status ;;
      6) restart_screen ;;
      7) choose_computer ;;
      8) set_pin ;;
      q|Q) say "Done."; exit 0 ;;
      '') ;;
      *) say "That is not one of the choices." ;;
    esac
  done
}

# Runs only when the file is started, so a test can load the functions
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
