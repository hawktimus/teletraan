#!/bin/bash
# Updates the Mini from this Mac, and keeps its keys and its calendar links.
# Run it by double-clicking "Teletraan Mini.command" in Finder, or in a terminal:
#
#   tools/mini/teletraan-mini                 the menu
#   tools/mini/teletraan-mini update          copy the files, then restart the screen
#   tools/mini/teletraan-mini status          show what the Mini last did
#   tools/mini/teletraan-mini restart         restart the screen
#
# A word after the name does what the same choice in the menu does, with no menu,
# and the exit code is not zero when a step fails, so deploy/mac/ship.sh can rely on
# it. --yes skips the "Go ahead?" question of update, and --mini NAME picks a saved
# Mini other than the one in use. docs/updating-the-mini.md explains each choice.
#
# The keys and the calendar links are secrets. They live in ~/.teletraan/secrets.env
# on this Mac and in deploy/local.env on the Mini, and nowhere else. This script
# never prints one: it shows the first 4 characters and dots, and it sends the
# values with scp, so no command line carries one.
#
# This runs on the bash that comes with macOS, which is version 3.2. That is why
# it has no associative arrays and no case conversion in the shell itself.

set -u

# The Mini's repository folder and the name of the screen's service. These are
# not secrets; change them here if the Mini changes.
MINI_REPO=${MINI_REPO:-/opt/teletraan}
MINI_KIOSK=${MINI_KIOSK:-teletraan-kiosk.service}

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
repo=$(cd "$here/../.." && pwd)

state_dir=$HOME/.teletraan
config_file=$state_dir/config
secrets_file=$state_dir/secrets.env

# What a key, a link, an address and a name may look like. The keys use the rule
# the scripts on the Mini use. A link is checked for the characters a calendar
# address has, because it is written between quotes in two other files.
key_pattern='^[A-Za-z0-9_.-]+$'
link_pattern='^[A-Za-z0-9._~:/?#@!&()*+,;=%-]+$'
address_pattern='^[A-Za-z0-9][A-Za-z0-9._-]*@[A-Za-z0-9][A-Za-z0-9._-]*$'
name_pattern='^[a-z0-9][a-z0-9_-]{0,19}$'
folder_pattern='^/[A-Za-z0-9/._-]+$'

# The Minis this Mac knows, and the one in use
mini_names=()
mini_addresses=()
mini_count=0
current_name=''
mini_name=''
address=''

# The keys and calendars saved on this Mac. A key is 0 when it is not set, 1 when
# it has a value and 2 when it was cleared and the Mini has not been told yet. A
# calendar with an empty value was removed and the Mini has not been told yet.
key_names=(SANITY_WRITE_TOKEN MONDAY_API_TOKEN TBA_AUTH_KEY)
key_labels=('Sanity write token' 'Monday token' 'The Blue Alliance key')
key_uses=('lets the Mini write its status and the Monday tasks into Sanity' 'lets the Mini read the Monday boards' 'lets the Mini read the competition data')
key_values=('' '' '')
key_states=(0 0 0)
cal_names=()
cal_values=()
cal_count=0

# Filled by check_key, check_link and prompt
clean_value=''
clean_reason=''
answer=''

# Set when a command word is given instead of the menu. The steps are the same.
# What differs: a question that nobody answers counts as no, and a step that did
# not happen is a failure, because a script is waiting for the exit code.
command_mode=no
assume_yes=no
declined_status=0

say() { printf '%s\n' "$*"; }

step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }

problem() { printf '\nStopped: %s\n' "$*" >&2; }

# The menu ends quietly when the input does, so a closed terminal cannot loop. A
# command has nobody to ask, so it stops, and says why.
input_ended() {
  printf '\n'
  if [ "$command_mode" = yes ]; then
    problem "a question needed an answer and none came, so nothing more was done."
    exit 1
  fi
  exit 0
}

# Asks a question and reads one line into $answer
prompt() {
  printf '%s' "$1"
  IFS= read -r answer || input_ended
}

# The same, with the typing hidden, for a key or a link
prompt_hidden() {
  printf '%s' "$1"
  IFS= read -rs answer || input_ended
  printf '\n'
}

# The second word is the answer for pressing Return, so a risky question can
# default to no.
ask_yes() {
  local reply
  if [ "$2" = yes ]; then prompt "$1 [Y/n] "; else prompt "$1 [y/N] "; fi
  reply=$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')
  [ -n "$reply" ] || reply=$2
  [ "$reply" = y ] || [ "$reply" = yes ]
}

# A hint names another step as a menu choice in the menu and as a command word on
# the command line
words() {
  if [ "$command_mode" = yes ]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

# The first 4 characters, then dots. A value too short to show 4 characters of
# safely is all dots, and a placeholder or nothing is "not set".
mask() {
  local value=$1
  case $value in
    ''|'['*) printf 'not set'; return 0 ;;
  esac
  if [ "${#value}" -ge 12 ]; then
    printf '%s........' "${value:0:4}"
  else
    printf '........'
  fi
}

# Checks a key. The reason never holds the key.
check_key() {
  clean_value=$1
  clean_reason=''
  if ! printf '%s' "$clean_value" | grep -Eq "$key_pattern"; then
    clean_reason='A key has letters, digits, dots, dashes and underscores only, with nothing else on the line.'
    return 1
  fi
  return 0
}

# Checks a calendar link. On success clean_value is the link to store, and a
# webcal:// link has become an https:// one. The reason never holds the link.
check_link() {
  clean_value=$1
  clean_reason=''
  case $clean_value in
    webcal://*) clean_value="https://${clean_value#webcal://}" ;;
    http://*)
      clean_reason='The link starts with http://, which is not secure. Use the https:// link.'
      return 1
      ;;
  esac
  case $clean_value in
    https://*) ;;
    *)
      clean_reason='A calendar link starts with https:// or webcal://.'
      return 1
      ;;
  esac
  if ! printf '%s' "$clean_value" | grep -Eq "$link_pattern"; then
    clean_reason='The link has a space, a quote or another character a calendar link does not have.'
    return 1
  fi
  return 0
}

# "Build season" becomes BUILD_SEASON, which is the middle of
# CALENDAR_BUILD_SEASON_URL
calendar_id() {
  printf '%s' "$1" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9]\{1,\}/_/g; s/^_//; s/_$//'
}

# The lowercase code that Studio uses for CALENDAR_<ID>_URL
calendar_code() {
  local code=${1#CALENDAR_}
  code=${code%_URL}
  printf '%s' "$code" | tr '[:upper:]' '[:lower:]'
}

# The place of the calendar with this code in the list, or nothing
find_calendar() {
  local wanted i=0
  wanted=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
  while [ "$i" -lt "$cal_count" ]; do
    if [ "$(calendar_code "${cal_names[$i]}")" = "$wanted" ]; then
      printf '%s' "$i"
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

set_calendar() {
  local place
  place=$(find_calendar "$(calendar_code "$1")")
  if [ -n "$place" ]; then
    cal_values[$place]=$2
  else
    cal_names[$cal_count]=$1
    cal_values[$cal_count]=$2
    cal_count=$((cal_count + 1))
  fi
}

set_key() {
  local i=0
  while [ "$i" -lt "${#key_names[@]}" ]; do
    if [ "${key_names[$i]}" = "$1" ]; then
      key_values[$i]=$2
      if [ -n "$2" ]; then key_states[$i]=1; else key_states[$i]=2; fi
      return 0
    fi
    i=$((i + 1))
  done
  return 1
}

# The value of a NAME=value line without its quotes, the way the scripts on the
# Mini read it
unquote() {
  local value=$1
  case $value in [\'\"]*) value=${value#?} ;; esac
  case $value in *[\'\"]) value=${value%?} ;; esac
  printf '%s' "$value"
}

# Puts one NAME=value line into the lists. A value that is empty, a placeholder
# or not usable is left out, and its name is added to $skipped.
skipped=''
take_line() {
  local name=${1%%=*} value
  value=$(unquote "${1#*=}")
  case $name in
    SANITY_WRITE_TOKEN|MONDAY_API_TOKEN|TBA_AUTH_KEY)
      case $value in
        '') set_key "$name" '' ;;
        '['*) ;;
        *)
          if check_key "$value"; then set_key "$name" "$clean_value"; else skipped="$skipped $name"; fi
          ;;
      esac
      ;;
    CALENDAR_*_URL)
      if ! printf '%s' "$name" | grep -Eq '^CALENDAR_[A-Za-z0-9_]+_URL$'; then
        skipped="$skipped $name"
        return 0
      fi
      case $value in
        '') set_calendar "$name" '' ;;
        '['*) ;;
        *)
          if check_link "$value"; then set_calendar "$name" "$clean_value"; else skipped="$skipped $name"; fi
          ;;
      esac
      ;;
  esac
}

reset_secrets() {
  key_values=('' '' '')
  key_states=(0 0 0)
  cal_names=()
  cal_values=()
  cal_count=0
}

load_secrets() {
  local line
  reset_secrets
  skipped=''
  [ -f "$secrets_file" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    take_line "$line"
  done < "$secrets_file"
  if [ -n "$skipped" ]; then
    say "These saved values were not usable and were left out:$skipped"
  fi
  return 0
}

# Writes ~/.teletraan/secrets.env with mode 600, in one step
write_secrets() {
  local temp=$secrets_file.new i=0
  (
    umask 077
    {
      while [ "$i" -lt "${#key_names[@]}" ]; do
        case ${key_states[$i]} in
          1) printf "%s='%s'\n" "${key_names[$i]}" "${key_values[$i]}" ;;
          2) printf "%s=''\n" "${key_names[$i]}" ;;
        esac
        i=$((i + 1))
      done
      i=0
      while [ "$i" -lt "$cal_count" ]; do
        printf "%s='%s'\n" "${cal_names[$i]}" "${cal_values[$i]}"
        i=$((i + 1))
      done
    } > "$temp"
  ) && chmod 600 "$temp" && mv -f "$temp" "$secrets_file"
}

# After the Mini has the values, a cleared key and a removed calendar are gone
# for good, so the saved file matches the Mini
forget_cleared() {
  local i=0 names=() values=() count=0
  while [ "$i" -lt "${#key_names[@]}" ]; do
    if [ "${key_states[$i]}" = 2 ]; then key_states[$i]=0; fi
    i=$((i + 1))
  done
  i=0
  while [ "$i" -lt "$cal_count" ]; do
    if [ -n "${cal_values[$i]}" ]; then
      names[$count]=${cal_names[$i]}
      values[$count]=${cal_values[$i]}
      count=$((count + 1))
    fi
    i=$((i + 1))
  done
  cal_names=()
  cal_values=()
  cal_count=0
  i=0
  while [ "$i" -lt "$count" ]; do
    cal_names[$i]=${names[$i]}
    cal_values[$i]=${values[$i]}
    i=$((i + 1))
  done
  cal_count=$count
}

# Everything in the output of the Mini goes through this, so that a script that
# one day prints a link or a key still cannot show one on this screen. It hides
# every saved value and anything that looks like a web address.
hide_secrets() {
  awk -v file="$secrets_file" '
    BEGIN {
      quote = sprintf("%c", 39)
      while ((getline line < file) > 0) {
        at = index(line, "=")
        if (at < 2) continue
        value = substr(line, at + 1)
        if (substr(value, 1, 1) == quote) value = substr(value, 2)
        if (substr(value, length(value), 1) == quote) value = substr(value, 1, length(value) - 1)
        if (length(value) >= 6) hide[++count] = value
      }
      close(file)
    }
    {
      text = $0
      for (i = 1; i <= count; i++) {
        done = ""
        while ((at = index(text, hide[i])) > 0) {
          done = done substr(text, 1, at - 1) "(hidden)"
          text = substr(text, at + length(hide[i]))
        }
        text = done text
      }
      gsub(/[A-Za-z][A-Za-z0-9+.-]*:\/\/[^ ]*/, "(address hidden)", text)
      print text
    }
  '
}

load_config() {
  local key value
  mini_names=()
  mini_addresses=()
  mini_count=0
  current_name=''
  [ -f "$config_file" ] || return 0
  while IFS='=' read -r key value || [ -n "$key" ]; do
    case $key in
      current) current_name=$value ;;
      mini.*)
        if printf '%s' "${key#mini.}" | grep -Eq "$name_pattern" && printf '%s' "$value" | grep -Eq "$address_pattern"; then
          mini_names[$mini_count]=${key#mini.}
          mini_addresses[$mini_count]=$value
          mini_count=$((mini_count + 1))
        fi
        ;;
    esac
  done < "$config_file"
  return 0
}

save_config() {
  local temp=$config_file.new i=0
  {
    printf '# Written by tools/mini/teletraan-mini. One mini.NAME=user@host line for each Mini.\n'
    printf 'current=%s\n' "$current_name"
    while [ "$i" -lt "$mini_count" ]; do
      printf 'mini.%s=%s\n' "${mini_names[$i]}" "${mini_addresses[$i]}"
      i=$((i + 1))
    done
  } > "$temp" && chmod 600 "$temp" && mv -f "$temp" "$config_file"
}

use_mini() {
  mini_name=${mini_names[$1]}
  address=${mini_addresses[$1]}
  current_name=$mini_name
}

# Runs one command on the Mini. A first word of -t gives the command a terminal,
# which sudo needs to ask for the password here in this window. Without it ssh
# gets no input (-n), so it cannot take the next lines of the menu for itself.
mini_run() {
  if [ "$1" = -t ]; then
    ssh -t -o ConnectTimeout=10 "$address" "$2"
  else
    ssh -n -o ConnectTimeout=10 "$address" "$1"
  fi
}

# A failed ssh, scp or rsync in plain words. 255 is ssh's own code for "could
# not connect".
explain_failure() {
  if [ "$1" = 255 ]; then
    problem "could not reach $address. Is the Mini on, and is this Mac on its network or on Tailscale?"
  else
    problem "the Mini reported a problem (exit $1). The lines above say what."
  fi
}

check_ssh() {
  say "Checking that ssh works..."
  if ssh -n -o ConnectTimeout=10 "$1" true; then
    say "Connected."
    return 0
  fi
  problem "could not connect to $1 with ssh. Check the address, that the Mini is on, and that this Mac is on its network or on Tailscale. Nothing was saved."
  return 1
}

add_mini() {
  local new_address new_name suggestion=main i=0
  say "Type the Mini's address as user@host. A Tailscale name works from anywhere, for example hawktimus@teletraan."
  prompt "Address: "
  new_address=$answer
  if ! printf '%s' "$new_address" | grep -Eq "$address_pattern"; then
    problem "that is not an address like user@host."
    return 1
  fi
  check_ssh "$new_address" || return 1

  if [ "$mini_count" -gt 0 ]; then suggestion=spare; fi
  prompt "A short name for this Mini [$suggestion]: "
  new_name=$answer
  [ -n "$new_name" ] || new_name=$suggestion
  if ! printf '%s' "$new_name" | grep -Eq "$name_pattern"; then
    problem "a name has lowercase letters, digits, dashes and underscores, up to 20 characters."
    return 1
  fi
  while [ "$i" -lt "$mini_count" ]; do
    if [ "${mini_names[$i]}" = "$new_name" ]; then
      problem "there is a Mini called $new_name already. Pick another name."
      return 1
    fi
    i=$((i + 1))
  done

  mini_names[$mini_count]=$new_name
  mini_addresses[$mini_count]=$new_address
  mini_count=$((mini_count + 1))
  use_mini $((mini_count - 1))
  save_config || { problem "could not save $config_file."; return 1; }
  say "Saved. The Mini in use is $mini_name."
}

first_run() {
  step "First run"
  say "This tool needs to know where the Mini is. The address is saved in $config_file, which is not part of the repository."
  while ! add_mini; do
    ask_yes "Try again?" yes || return 1
  done
}

choose_mini() {
  local i=0 marker
  step "Choose a Mini"
  while [ "$i" -lt "$mini_count" ]; do
    marker=''
    if [ "${mini_names[$i]}" = "$mini_name" ]; then marker='  (in use)'; fi
    printf '  %s  %s (%s)%s\n' "$((i + 1))" "${mini_names[$i]}" "${mini_addresses[$i]}" "$marker"
    i=$((i + 1))
  done
  say "  a  Add another Mini"
  prompt "Choose, or press Return to stay with $mini_name: "
  case $answer in
    '') ;;
    a|A) add_mini ;;
    *[!0-9]*) say "That is not one of the choices." ;;
    *)
      if [ "$answer" -ge 1 ] && [ "$answer" -le "$mini_count" ]; then
        use_mini $((answer - 1))
        save_config || problem "could not save $config_file."
        say "The Mini in use is $mini_name."
      else
        say "That is not one of the choices."
      fi
      ;;
  esac
}

# Writes dashboard/build.js on the Mini with the build $1 (a hash or a time), in one step
write_build_js() {
  mini_run "printf 'export const build = \"%s\";\\n' '$1' > $MINI_REPO/dashboard/.build.js.new && mv -f $MINI_REPO/dashboard/.build.js.new $MINI_REPO/dashboard/build.js"
}

# Tells the Mini which build it was given. rsync leaves the .git folder of the Mini alone, so the
# hash, the date and the branch are read here, from this repository, and left in deploy/build.txt for
# status-write.sh version. It also leaves dashboard/build.js, the build the page asks its files for
# (index.html): the hash when there is one, else the time. A failure here is only said: the screen
# still updates.
stamp_build() {
  local commit built branch
  commit=$(git -C "$repo" rev-parse --short HEAD 2> /dev/null)
  built=$(git -C "$repo" log -1 --format=%cs 2> /dev/null)
  branch=$(git -C "$repo" rev-parse --abbrev-ref HEAD 2> /dev/null)
  if ! printf '%s' "$commit" | grep -Eq '^[0-9a-f]{4,40}$' ||
    ! printf '%s' "$built" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}$' ||
    ! printf '%s' "$branch" | grep -Eq '^[A-Za-z0-9._/-]{1,100}$'; then
    say "This folder has no git history, so the build shown on the wall is not updated."
    write_build_js "t$(date -u +%Y%m%d%H%M%S)" || say "The file the page reads its build from could not be written."
    return 0
  fi
  write_build_js "$commit" || say "The file the page reads its build from could not be written."
  if mini_run "printf 'commit=%s\\ndate=%s\\nbranch=%s\\n' '$commit' '$built' '$branch' > $MINI_REPO/deploy/build.txt" &&
    mini_run "$MINI_REPO/deploy/scripts/status-write.sh version"; then
    say "The build on the wall is $commit, $built."
  else
    say "The build on the wall could not be written. The update itself is done."
  fi
}

# 1. Copy the repository to the Mini and restart the screen
update_mini() {
  local timer status
  step "Update the Mini ($mini_name)"

  # --delete removes files on the Mini that are not here, so this must be the
  # real repository
  if [ ! -f "$repo/dashboard/index.html" ] || [ ! -f "$repo/deploy/scripts/pull.sh" ]; then
    problem "$repo does not look like the Teletraan repository, so nothing was copied."
    return 1
  fi

  say "This copies the files in this repository to $address:$MINI_REPO and removes files there that are not here."
  say "The Mini keeps its local.env, its .git folder and its node_modules. The screen restarts at the end and is black for about ten seconds."

  timer=$(mini_run "systemctl is-active teletraan-pull.timer")
  status=$?
  if [ "$status" = 255 ]; then
    explain_failure "$status"
    return 1
  fi
  if [ "$timer" = active ]; then
    say ""
    say "This Mini also pulls from GitHub by itself (the pull timer is on). A pull stops with an error once a file changed here is also changed by a new commit."
    say "Use this copy or the pull, not both. docs/updating-the-mini.md says how to turn the pull timer off."
    ask_yes "Copy anyway?" no || { say "Nothing was copied."; return "$declined_status"; }
  elif [ "$assume_yes" = yes ]; then
    say "Going ahead (--yes)."
  else
    ask_yes "Go ahead?" yes || { say "Nothing was copied."; return "$declined_status"; }
  fi

  rsync -a --delete \
    --exclude .git --exclude local.env --exclude .env --exclude node_modules \
    --exclude .DS_Store --exclude studio/dist --exclude studio/.sanity \
    -e "ssh -o ConnectTimeout=10" "$repo/" "$address:$MINI_REPO/"
  status=$?
  if [ "$status" -ne 0 ]; then
    explain_failure "$status"
    say "The Mini may have some of the new files and not others. Run this again."
    return 1
  fi
  say "The files are copied."
  stamp_build

  mini_run -t "sudo systemctl restart $MINI_KIOSK"
  status=$?
  if [ "$status" -ne 0 ]; then
    explain_failure "$status"
    say "The files are on the Mini. $(words 'Choose 6 to restart the screen again.' 'Run teletraan-mini restart to restart the screen again.')"
    return 1
  fi
  say "Done. If this update changed anything in deploy/systemd, $(words 'choose 4' 'run teletraan-mini with no word after it and choose 4') to install the services again."
}

show_keys() {
  local i=0
  while [ "$i" -lt "${#key_names[@]}" ]; do
    case ${key_states[$i]} in
      1) printf '  %-24s %s\n' "${key_labels[$i]}" "$(mask "${key_values[$i]}")" ;;
      2) printf '  %-24s %s\n' "${key_labels[$i]}" "cleared, not sent yet" ;;
      *) printf '  %-24s %s\n' "${key_labels[$i]}" "not set" ;;
    esac
    i=$((i + 1))
  done
}

# Where a changed value is noted for the list before saving
change_notes=()
change_count=0
note_change() {
  change_notes[$change_count]=$1
  change_count=$((change_count + 1))
}

edit_key() {
  local i=$1
  say ""
  say "${key_labels[$i]} (${key_names[$i]}) ${key_uses[$i]}."
  case ${key_states[$i]} in
    1) say "  Now: $(mask "${key_values[$i]}")" ;;
    2) say "  Now: cleared, not sent yet" ;;
    *) say "  Now: not set" ;;
  esac
  if [ "${key_states[$i]}" = 0 ]; then
    prompt "  Add it? [e adds it, Return leaves it unset] "
  else
    prompt "  Edit, keep or clear? [e/k/c, Return keeps] "
  fi
  case $(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]') in
    e|edit)
      prompt_hidden "  New value (the typing is hidden): "
      if [ -z "$answer" ]; then
        say "  Nothing typed, so it is kept."
      elif check_key "$answer"; then
        set_key "${key_names[$i]}" "$clean_value"
        say "  Now: $(mask "$clean_value")"
        note_change "${key_labels[$i]}: new value"
      else
        say "  Not saved. $clean_reason It is kept as it was."
      fi
      ;;
    c|clear)
      if [ "${key_states[$i]}" != 0 ]; then
        key_values[$i]=''
        key_states[$i]=2
        note_change "${key_labels[$i]}: cleared"
      fi
      say "  Cleared."
      ;;
    *) ;;
  esac
}

# The calendars that have a link, numbered. visible[n] is their place in the list.
visible=()
visible_count=0
show_calendars() {
  local i=0 n=0
  visible=()
  while [ "$i" -lt "$cal_count" ]; do
    if [ -n "${cal_values[$i]}" ]; then
      visible[$n]=$i
      n=$((n + 1))
      printf '  %s  %-22s %s\n' "$n" "$(calendar_code "${cal_names[$i]}")" "$(mask "${cal_values[$i]}")"
    fi
    i=$((i + 1))
  done
  visible_count=$n
  if [ "$n" = 0 ]; then say "  No calendars yet."; fi
}

# Asks for a link until it can be used, or until nothing is typed. Sets
# clean_value, and returns 1 when nothing was typed.
ask_link() {
  while true; do
    prompt_hidden "  Link (https:// or webcal://, the typing is hidden): "
    [ -n "$answer" ] || return 1
    if check_link "$answer"; then
      say "  Link: $(mask "$clean_value")"
      return 0
    fi
    say "  $clean_reason"
  done
}

ask_calendar_number() {
  prompt "  Which number? "
  case $answer in
    ''|*[!0-9]*) say "  That is not a number in the list."; return 1 ;;
  esac
  if [ "$answer" -lt 1 ] || [ "$answer" -gt "$visible_count" ]; then
    say "  That is not a number in the list."
    return 1
  fi
  return 0
}

edit_calendars() {
  local id place number name
  while true; do
    say ""
    say "Calendars: the name Studio uses, then the first 4 characters of the link."
    show_calendars
    prompt "Add, edit or remove one? [a/e/r, Return when done] "
    case $(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]') in
      a|add)
        prompt "  Name (such as team or build season): "
        id=$(calendar_id "$answer")
        if [ -z "$id" ] || [ "${#id}" -gt 20 ]; then
          say "  A name has letters and digits, up to 20 of them."
          continue
        fi
        place=$(find_calendar "$id")
        if [ -n "$place" ]; then
          say "  There is a calendar called $(calendar_code "$id") already. Its link will be replaced."
        fi
        if ask_link; then
          set_calendar "CALENDAR_${id}_URL" "$clean_value"
          note_change "calendar $(calendar_code "$id"): saved"
          say "  In Studio, Dashboard Settings, Calendars needs a row with the code $(calendar_code "$id") so the screen shows it."
        fi
        ;;
      e|edit)
        ask_calendar_number || continue
        number=$((answer - 1))
        place=${visible[$number]}
        name=$(calendar_code "${cal_names[$place]}")
        say "  Calendar $name"
        if ask_link; then
          cal_values[$place]=$clean_value
          note_change "calendar $name: new link"
        fi
        ;;
      r|remove)
        ask_calendar_number || continue
        number=$((answer - 1))
        place=${visible[$number]}
        name=$(calendar_code "${cal_names[$place]}")
        if ask_yes "  Remove the calendar $name?" no; then
          cal_values[$place]=''
          note_change "calendar $name: removed"
          say "  Removed. Take its row out of Dashboard Settings, Calendars in Studio too."
        fi
        ;;
      '') return 0 ;;
      *) say "  Type a, e or r, or press Return." ;;
    esac
  done
}

# Sends ~/.teletraan/secrets.env to the Mini and merges it into deploy/local.env
# there. The values travel in a file with scp; the merge script and the file are
# copied to a private folder first so they land with fixed names, and are removed
# on the Mini when the merge is done.
send_to_mini() {
  local stage=$state_dir/stage status remote
  rm -rf "$stage"
  if ! mkdir -p "$stage" || ! chmod 700 "$stage" ||
    ! cp "$secrets_file" "$stage/teletraan-incoming.env" || ! cp "$here/merge-env.sh" "$stage/teletraan-merge.sh"; then
    rm -rf "$stage"
    problem "could not prepare the files to send."
    return 1
  fi

  scp -q -o ConnectTimeout=10 "$stage/teletraan-incoming.env" "$stage/teletraan-merge.sh" "$address:"
  status=$?
  rm -rf "$stage"
  if [ "$status" -ne 0 ]; then
    problem "could not send the values to $address (exit $status). Nothing on the Mini changed."
    return 1
  fi

  remote="MINI_REPO='$MINI_REPO'
$(cat <<'EOF'
sh teletraan-merge.sh "$MINI_REPO/deploy/local.env" teletraan-incoming.env
status=$?
rm -f teletraan-merge.sh teletraan-incoming.env
[ "$status" -eq 0 ] || exit "$status"
if sudo systemctl start teletraan-calendars.service; then
  echo "The calendar service ran once, so the Calendars page in Studio is up to date."
else
  echo "The calendar service did not run. If it is not installed on this Mini, choose 4 in the menu."
fi
EOF
)"
  mini_run -t "$remote"
  status=$?
  if [ "$status" -ne 0 ]; then
    explain_failure "$status"
    say "The values are saved on this Mac. Choose 2 and save again when the Mini can be reached."
    return 1
  fi
  return 0
}

# 2. The form for the keys and the calendars
keys_and_calendars() {
  local i=0
  step "Keys and calendars for the Mini $mini_name"
  load_secrets
  change_notes=()
  change_count=0

  say "Each value is shown as its first 4 characters and dots. For a key, press e to edit it, k to keep it or c to clear it."
  say "A Mac that has no saved values yet should use choice 3 first, so the Mini's values are shown here."

  while [ "$i" -lt "${#key_names[@]}" ]; do
    edit_key "$i"
    i=$((i + 1))
  done
  edit_calendars

  say ""
  if [ "$change_count" = 0 ]; then
    say "Nothing changed."
    ask_yes "Send the saved values to the Mini anyway?" no || return 0
  else
    say "Changes:"
    i=0
    while [ "$i" -lt "$change_count" ]; do
      say "  ${change_notes[$i]}"
      i=$((i + 1))
    done
    ask_yes "Save these on this Mac and send them to the Mini $mini_name?" yes || { say "Nothing was saved."; return 0; }
  fi

  if ! write_secrets; then
    problem "could not save $secrets_file."
    return 1
  fi
  say "Saved on this Mac in $secrets_file."
  send_to_mini || return 1
  forget_cleared
  write_secrets || problem "could not tidy $secrets_file."
  say "Done. The Mini has the new values."
}

# 3. Copy what the Mini holds to this Mac, for a second computer
pull_from_mini() {
  local raw=$state_dir/pulled.tmp status names
  step "Copy the Mini's keys and calendars to this Mac"
  say "This replaces the values saved on this Mac with the ones in deploy/local.env on the Mini. Nothing is printed."
  ask_yes "Go ahead?" no || { say "Nothing changed."; return 0; }

  names='SANITY_WRITE_TOKEN|MONDAY_API_TOKEN|TBA_AUTH_KEY|CALENDAR_[A-Za-z0-9_]+_URL'
  (umask 077; mini_run "grep -E '^($names)=' '$MINI_REPO/deploy/local.env'" > "$raw")
  status=$?
  if [ "$status" = 255 ]; then
    rm -f "$raw"
    explain_failure "$status"
    return 1
  fi
  if [ "$status" -ne 0 ]; then
    rm -f "$raw"
    say "The Mini has no keys or calendar links in its local.env, or the file could not be read. Nothing changed."
    return 1
  fi

  local line
  reset_secrets
  skipped=''
  while IFS= read -r line || [ -n "$line" ]; do
    take_line "$line"
  done < "$raw"
  rm -f "$raw"
  forget_cleared

  if ! write_secrets; then
    problem "could not save $secrets_file."
    return 1
  fi
  say "Saved in $secrets_file:"
  show_keys
  show_calendars
  if [ -n "$skipped" ]; then
    say "These lines on the Mini did not look like a key or a link and were left out:$skipped"
  fi
}

# 4. The install scripts on the Mini
install_services() {
  local status remote
  step "Install the services on the Mini $mini_name"
  say "This runs install-calendars.sh, install-slides.sh, install-monday.sh, install-frc.sh, install-console.sh, install-watchdog.sh and install-backup.sh on the Mini. They turn on the timers (the watchdog and the nightly backup too) and the boot and shutdown screens, and install no packages."
  say "Each one says what it will do and waits for Enter. install-console.sh changes /etc/issue, and a missing package stops its script with the apt line to run."
  ask_yes "Has the team mentor said yes?" no || { say "Nothing was installed."; return 0; }

  remote="dir='$MINI_REPO/deploy/scripts'
$(cat <<'EOF'
for name in calendars slides monday frc console watchdog backup; do
  echo
  echo "== install-$name.sh"
  sudo "$dir/install-$name.sh" || echo "install-$name.sh stopped (exit $?)."
done
EOF
)"
  mini_run -t "$remote"
  status=$?
  if [ "$status" -ne 0 ]; then
    explain_failure "$status"
    return 1
  fi
}

# 5. What the Mini last did, and what the screen does with each calendar
mini_status() {
  local status result=0
  step "Status of the Mini $mini_name"
  mini_run "$MINI_REPO/deploy/scripts/status-write.sh --print" 2>&1 | hide_secrets
  status=${PIPESTATUS[0]}
  if [ "$status" = 255 ]; then
    explain_failure "$status"
    return 1
  elif [ "$status" = 2 ]; then
    say "The Mini has an older status-write.sh. $(words 'Choose 1 to update it.' 'Run teletraan-mini update.')"
    result=1
  elif [ "$status" -ne 0 ]; then
    result=1
  fi

  say ""
  say "Calendars:"
  mini_run "$MINI_REPO/deploy/scripts/check-calendars.sh" 2>&1 | hide_secrets
  if [ "${PIPESTATUS[0]}" = 255 ]; then
    explain_failure 255
    return 1
  fi
  return "$result"
}

# 6. Restart the browser that fills the TV
restart_screen() {
  local status
  step "Restart the screen on the Mini $mini_name"
  mini_run -t "sudo systemctl restart $MINI_KIOSK"
  status=$?
  if [ "$status" -ne 0 ]; then
    explain_failure "$status"
    return 1
  fi
  say "The screen restarted. It is black for about ten seconds."
}

show_menu() {
  say ""
  say "Teletraan Mini"
  say ""
  say "Mini in use: $mini_name ($address)"
  say ""
  say "  1  Update the Mini with the files on this Mac, then restart the screen"
  say "  2  Keys and calendars"
  say "  3  Copy the Mini's keys and calendars to this Mac"
  say "  4  Install the services on the Mini"
  say "  5  Status of the Mini"
  say "  6  Restart the screen"
  say "  7  Choose another Mini, or add one"
  say "  q  Quit"
  say ""
}

usage() {
  say "Usage: teletraan-mini [--mini NAME] [--yes] [update | status | restart]"
  say ""
  say "  (no word)  show the menu"
  say "  update     copy the files to the Mini, then restart the screen"
  say "  status     show what the Mini last did"
  say "  restart    restart the screen"
  say "  --yes      with update, do not ask Go ahead?"
  say "  --mini     use the saved Mini with this name instead of the one in use"
}

# A wrong word is not repeated back, in case it was a key or an address typed by mistake
bad_arguments() {
  problem "$1"
  usage >&2
  exit 2
}

saved_names() {
  local i=0 list=''
  while [ "$i" -lt "$mini_count" ]; do
    if [ -n "$list" ]; then list="$list, "; fi
    list="$list${mini_names[$i]}"
    i=$((i + 1))
  done
  printf '%s' "$list"
}

main() {
  local command command_word='' wanted_mini='' wanted i=0 found=no
  while [ "$#" -gt 0 ]; do
    case $1 in
      update|status|restart)
        if [ -n "$command_word" ]; then bad_arguments "give one word, not two."; fi
        command_word=$1
        ;;
      --yes|-y) assume_yes=yes ;;
      --mini)
        if [ "$#" -lt 2 ]; then bad_arguments "--mini needs the name of a saved Mini."; fi
        wanted_mini=$2
        shift
        ;;
      --mini=*) wanted_mini=${1#--mini=} ;;
      -h|--help|help) usage; exit 0 ;;
      *) bad_arguments "that is not a word this tool knows." ;;
    esac
    shift
  done
  if [ "$assume_yes" = yes ] && [ -z "$command_word" ]; then
    bad_arguments "--yes goes with update, status or restart."
  fi

  for command in ssh scp rsync; do
    if ! command -v "$command" > /dev/null 2>&1; then
      problem "$command is not installed on this Mac. It comes with macOS, so something is wrong with this Mac."
      exit 1
    fi
  done
  if ! printf '%s' "$MINI_REPO" | grep -Eq "$folder_pattern"; then
    problem "MINI_REPO must be a plain folder path such as /opt/teletraan."
    exit 1
  fi
  if ! printf '%s' "$MINI_KIOSK" | grep -Eq "$key_pattern"; then
    problem "MINI_KIOSK must be the name of a service such as teletraan-kiosk.service."
    exit 1
  fi

  # Ctrl+C while a hidden value is being typed must not leave the terminal silent
  trap 'stty echo 2> /dev/null' EXIT

  mkdir -p "$state_dir" && chmod 700 "$state_dir" || { problem "could not make $state_dir."; exit 1; }
  load_config
  if [ -n "$command_word" ]; then
    command_mode=yes
    declined_status=1
  fi
  if [ "$mini_count" = 0 ]; then
    if [ "$command_mode" = yes ]; then
      problem "no Mini is saved on this Mac yet. Run tools/mini/teletraan-mini with no word after it, once, and give it the Mini's address."
      exit 1
    fi
    first_run || exit 1
  fi

  wanted=${wanted_mini:-$current_name}
  use_mini 0
  while [ "$i" -lt "$mini_count" ]; do
    if [ "${mini_names[$i]}" = "$wanted" ]; then
      use_mini "$i"
      found=yes
    fi
    i=$((i + 1))
  done
  if [ -n "$wanted_mini" ] && [ "$found" = no ]; then
    problem "no saved Mini has that name. The saved names are: $(saved_names)."
    exit 1
  fi

  case $command_word in
    update) update_mini; exit $? ;;
    status) mini_status; exit $? ;;
    restart) restart_screen; exit $? ;;
  esac

  while true; do
    show_menu
    prompt "Choose: "
    case $answer in
      1) update_mini ;;
      2) keys_and_calendars ;;
      3) pull_from_mini ;;
      4) install_services ;;
      5) mini_status ;;
      6) restart_screen ;;
      7) choose_mini ;;
      q|Q) say "Done."; exit 0 ;;
      '') ;;
      *) say "That is not one of the choices." ;;
    esac
  done
}

# Runs only when the file is started, so a test can load the functions
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
