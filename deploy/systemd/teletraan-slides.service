[Unit]
Description=Download the slides for the next talks for Teletraan I
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# ACCOUNT is replaced by install-slides.sh with the account that owns the
# repository, so this file does not depend on what the Mini's user is called.
User=ACCOUNT
ExecStart=/opt/teletraan/deploy/scripts/slides-sync.sh
# Each download gives up after 90 seconds. This is for the whole run.
TimeoutStartSec=15min
