# Copy this file to local.env and fill it in. The real file is local.env: it
# is never committed and only the Mini's account may read it (chmod 600).
#
# One NAME=value per line. Put each value in single quotes and do not put a
# comment on the same line as a value.

# The folder on the Mini where downloaded calendars, slides and version.txt
# are kept. It must exist before the container starts, and the account that
# runs the timers must be allowed to write to it.
TELETRAAN_DATA='/var/lib/teletraan/data'

# The dashboard is reachable at http://localhost:<port>/dashboard/ on the Mini only
TELETRAAN_PORT='8080'

# One line per BAND calendar: CALENDAR_<ID>_URL. Use capital letters, digits
# and underscores in the ID. The calendar is saved as <id in lowercase>.ics,
# so CALENDAR_TEAM_URL becomes team.ics. The dashboard only shows a calendar
# that has a row in Dashboard Settings, Calendars, whose code is that same
# lowercase id. Use the https:// or webcal:// address. A value that still
# starts with [ is skipped.
CALENDAR_TEAM_URL='[paste the iCal address of the team calendar here]'
